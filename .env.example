# Provider credentials for the agent runner. Never commit a real key.
# With no key set, use --provider mock: the whole harness runs offline and free.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_HOST=http://127.0.0.1:11434

# A key for any other OpenAI-compatible provider goes in its own variable, and
# the run names it: --api-key-env <variable>.
OPENROUTER_API_KEY=
ZAI_API_KEY=
